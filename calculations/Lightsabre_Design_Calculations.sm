    <region left="0" top="9" width="177" height="26" color="#000000" fontSize="12">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="text-decoration: underline; font-size: 12px; font-weight: bold;">1. Concept Selection:</p>
        </content>
      </text>
    </region>
    <region left="279" top="27" width="18" height="23" color="#000000" fontSize="10">
      <text lang="eng" width="18" fontFamily="Arial" fontSize="10">
        <content>
          <p> </p>
        </content>
      </text>
    </region>
    <region left="0" top="45" width="149" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="text-decoration: underline;">1.1 LED Configuration:</p>
        </content>
      </text>
    </region>
    <region left="0" top="72" width="90" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">L.strip</e>
          <e type="operand">1</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="333" top="72" width="439" height="20" color="#000000" fontSize="10"><text lang="eng" fontFamily="Arial" fontSize="10"><content><p style="font-size: 8px;">//Length of one LED strip</p></content></text></region><region left="0" top="108" width="134" height="43" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">N.strip</e>
          <e type="operand">60</e>
          <e type="operand" style="unit">LED</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">/</e>
          <e type="bracket">(</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="333" top="117" width="439" height="20" color="#000000" fontSize="10"><text lang="eng" fontFamily="Arial" fontSize="10"><content><p style="font-size: 8px;">//LED density of the WS2812B strip (60 LEDs per metre)</p></content></text></region><region left="0" top="153" width="121" height="41" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">N.strips</e>
          <e type="operand">2</e>
          <e type="operand">1</e>
          <e type="operand" style="unit">LED</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="333" top="162" width="439" height="20" color="#000000" fontSize="10"><text lang="eng" fontFamily="Arial" fontSize="10"><content><p style="font-size: 8px;">//Two strips mounted back to back (each LED counted once per strip)</p></content></text></region><region left="0" top="189" width="247" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">N.LED</e>
          <e type="operand">L.strip</e>
          <e type="operand">N.strip</e>
          <e type="operator" args="2">*</e>
          <e type="operand">N.strips</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">120</e>
        </result>
      </math>
    </region>
    <region left="252" top="189" width="124" height="20" color="#000000" fontSize="8">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 8px;">//Total number of LEDs</p>
        </content>
      </text>
    </region>
    <region left="0" top="234" width="208" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="text-decoration: underline;">1.2 WS2812B Data Requirement</p>
        </content>
      </text>
    </region>
    <region left="0" top="270" width="73" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">B.LED</e>
          <e type="operand">24</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="333" top="270" width="439" height="20" color="#000000" fontSize="10"><text lang="eng" fontFamily="Arial" fontSize="10"><content><p style="font-size: 8px;">//Bits of colour data per LED (8 bits each for G, R and B)</p></content></text></region><region left="0" top="306" width="116" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">f.data</e>
          <e type="operand">800</e>
          <e type="operand" style="unit">kHz</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="333" top="306" width="439" height="20" color="#000000" fontSize="10"><text lang="eng" fontFamily="Arial" fontSize="10"><content><p style="font-size: 8px;">//WS2812B data rate</p></content></text></region><region left="0" top="333" width="181" height="51" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">t.LED</e>
          <e type="operand">B.LED</e>
          <e type="operand">f.data</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">3</e>
          <e type="operand">10</e>
          <e type="operand">5</e>
          <e type="operator" args="1">-</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">*</e>
          <e type="operand" style="unit">s</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="216" top="342" width="261" height="23" color="#000000" fontSize="8">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>
            <span style="font-size: 8px;">//The time required to transmit the data for one LED</span> </p>
        </content>
      </text>
    </region>
    <region left="0" top="387" width="287" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="text-decoration: underline;">1.3 Time Required for the Complete LED Strip</p>
        </content>
      </text>
    </region>
    <region left="0" top="414" width="185" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">B.Total</e>
          <e type="operand">N.LED</e>
          <e type="operand">B.LED</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">2880</e>
        </result>
      </math>
    </region>
    <region left="225" top="414" width="302" height="23" color="#000000" fontSize="8">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>
            <span style="font-size: 8px;">//The total number of bits transmitted to update all 120 LEDs</span> </p>
        </content>
      </text>
    </region>
    <region left="0" top="450" width="199" height="51" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">t.update</e>
          <e type="operand">B.Total</e>
          <e type="operand">f.data</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">0.0036</e>
          <e type="operand" style="unit">s</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="225" top="468" width="147" height="20" color="#000000" fontSize="8">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 8px;">//The total transmission time</p>
        </content>
      </text>
    </region>
    <region left="0" top="522" width="122" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">t.reset</e>
          <e type="operand">0.05</e>
          <e type="operand" style="unit">ms</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="333" top="531" width="430" height="20" color="#000000" fontSize="8">
      <text lang="eng" width="430" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 8px;">//WS2812B minimum reset (latch) time from the datasheet</p>
        </content>
      </text>
    </region>
    <region left="0" top="558" width="245" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">t.strip</e>
          <e type="operand">t.update</e>
          <e type="operand">t.reset</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">ms</e>
        </contract>
        <result action="numeric">
          <e type="operand">3.65</e>
        </result>
      </math>
    </region>
    <region left="333" top="567" width="430" height="20" color="#000000" fontSize="8">
      <text lang="eng" width="430" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 8px;">//Complete strip update including the reset time</p>
        </content>
      </text>
    </region>
    <region left="0" top="603" width="219" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="text-decoration: underline;">1.4 Required Lighting Update Rate</p>
