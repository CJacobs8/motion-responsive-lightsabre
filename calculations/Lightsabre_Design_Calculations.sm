    </region>
    <region left="365" top="11916" width="407" height="20" color="#000000" fontSize="10"><text lang="eng" fontFamily="Arial" fontSize="10"><content><p style="font-size: 8px;">//Second moment of area of the flange bond</p></content></text></region><region left="0" top="11961" width="294" height="70" color="#000000" fontSize="10">
