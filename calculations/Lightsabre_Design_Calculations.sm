    <region left="333" top="11646" width="439" height="20" color="#000000" fontSize="10"><text lang="eng" fontFamily="Arial" fontSize="10"><content><p style="font-size: 8px;">//Factor of safety of the cylindrical epoxy bond</p></content></text></region><region left="0" top="11709" width="760" height="23" color="#000000" fontSize="10">
