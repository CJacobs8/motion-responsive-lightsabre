        <input>
          <e type="operand">%</e>
        </input>
      </math>
    </region>
    <region left="288" top="711" width="406" height="20" color="#000000" fontSize="8">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p style="background-color: #ffffff; font-size: 8px;">//The percentage of the available update period used by the LED data transmission</p>
        </content>
      </text>
    </region>
    <region left="0" top="756" width="296" height="29" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">t.remaining</e>
          <e type="operand">T.required</e>
          <e type="operand">t.update</e>
          <e type="operator" args="2">-</e>
          <e type="operator" args="2">:</e>
        </input>
        <result action="numeric">
          <e type="operand">0.0164</e>
          <e type="operand" style="unit">s</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="333" top="756" width="439" height="20" color="#000000" fontSize="10"><text lang="eng" fontFamily="Arial" fontSize="10"><content><p style="font-size: 8px;">//Time left in each update period after the LED data is sent</p></content></text></region><region left="0" top="792" width="766" height="23" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p><span style="font-weight: bold;">Conclusion:</span> The LED data transmission occupies 18% of the 20 ms update period, leaving approximately 16.4 ms for other processing.</p></content>
      </text>
    </region>
