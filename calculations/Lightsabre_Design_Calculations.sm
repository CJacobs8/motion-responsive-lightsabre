    <region left="333" top="2538" width="439" height="20" color="#000000" fontSize="10"><text lang="eng" fontFamily="Arial" fontSize="10"><content><p style="font-size: 8px;">//Current of all LEDs at full white</p></content></text></region><region left="0" top="2565" width="77" height="29" color="#000000" fontSize="10">
